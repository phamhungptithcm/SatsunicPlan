{
  "hosting": {
    "site": "satsunicplan",
    "public": "preview/satsunicplan-readiness",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [{
      "source": "**",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
        {"key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]
    }]
  }
}
