{
  "functions": [
    {
      "source": "functions",
      "codebase": "workspace",
      "runtime": "nodejs22"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/mcp",
        "function": {
          "functionId": "mcp",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 19099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 18080,
      "websocketPort": 19151
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 15001
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 19199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "hub": {
      "host": "127.0.0.1",
      "port": 14400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 14500
    },
    "eventarc": {
      "host": "127.0.0.1",
      "port": 19299
    },
    "tasks": {
      "host": "127.0.0.1",
      "port": 19499
    }
  }
}
