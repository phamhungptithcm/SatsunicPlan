{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@plane/types": [
        "vendor/plane-community/packages/types/src/index.ts"
      ],
      "@plane/utils": [
        "src/lib/plane/date-utils.ts"
      ],
      "@hws/plane-adapter": [
        "src/lib/plane/timeline-context.tsx"
      ],
      "@/*": [
        "vendor/plane-community/apps/web/core/*"
      ],
      "@hws/plane-button": [
        "vendor/plane-community/packages/ui/src/button/button.tsx"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
