# Public Firebase web app settings only; copy verified values from satsunicplan.
# Template only. Opt-in is a local implementation feature, not deployment approval.
VITE_PRODUCT_NAME=SatsunicPlan
VITE_FIREBASE_MODE=cloud
VITE_FIREBASE_PROJECT_ID=satsunicplan
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_HUMAN_API_ENABLED=false
VITE_FIREBASE_APP_ORIGIN=
# Never put Admin credentials, service-account JSON or secrets in VITE_* values.
# Backend settings belong in the reviewed Functions environment, never VITE_*:
# HWS_FIREBASE_MODE=cloud
# HWS_HUMAN_API_ENABLED=true
# HWS_API_HOSTS=["<verified actual ingress host>","<verified application host>"]
# HWS_API_ORIGINS=["https://<verified application host>"]
# GCLOUD_PROJECT is platform-provided and must equal satsunicplan.
# Public MCP stays disabled in cloud regardless of these settings.
